<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="10dp" android:background="@drawable/task_card"
    android:orientation="vertical" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <CheckBox android:id="@+id/taskCompleted" android:layout_width="48dp"
            android:layout_height="48dp" />
        <TextView android:id="@+id/taskTitle" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:textSize="18sp" android:textColor="@color/workspace_text" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="end" android:orientation="horizontal">
        <Button android:id="@+id/editTask" style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:minHeight="48dp" android:text="@string/edit" android:textAllCaps="false" />
        <Button android:id="@+id/deleteTask" style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:minHeight="48dp" android:text="@string/delete" android:textColor="#B3261E"
            android:textAllCaps="false" />
    </LinearLayout>
</LinearLayout>
