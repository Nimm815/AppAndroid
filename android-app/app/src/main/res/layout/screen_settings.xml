<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <FrameLayout android:layout_width="match_parent" android:layout_height="76dp">
            <TextView style="@style/ScreenTitle" android:text="@string/settings" />
            <ImageButton android:id="@+id/settingsStar" style="@style/IconButton" app:srcCompat="@drawable/ic_star" android:contentDescription="Thông tin ứng dụng" android:layout_gravity="start|center_vertical" android:layout_marginStart="12dp" android:background="@drawable/control_gray" />
            <ImageButton android:id="@+id/settingsMenu" style="@style/IconButton" app:srcCompat="@drawable/ic_menu" android:contentDescription="@string/manage_lists" android:layout_gravity="end|center_vertical" android:layout_marginEnd="12dp" />
        </FrameLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/workspace_line" />
        <TextView android:layout_width="match_parent" android:layout_height="60dp" android:layout_margin="14dp" android:background="@drawable/control_soft" android:gravity="center" android:text="@string/local_account" android:textSize="16sp" android:textColor="@color/workspace_text" />
        <Button android:id="@+id/settingsSearch" style="@style/WideButton" android:text="@string/search_everything" android:background="@drawable/box_empty" android:gravity="start|center_vertical" />
        <Button android:id="@+id/help" style="@style/WideButton" android:text="@string/help" android:layout_marginTop="14dp" />
        <TextView android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="12dp" android:background="@color/workspace_canvas" android:gravity="start|center_vertical" android:paddingLeft="12dp" android:text="Cài đặt ứng dụng" android:textStyle="bold" android:textSize="16sp" android:textColor="@color/workspace_text" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="80dp" android:padding="12dp" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Giao diện" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/workspace_text" />
            <Button android:id="@+id/themeChoice" style="@style/FlatButton" android:layout_width="132dp" android:layout_height="54dp" android:text="Sáng   ﹀" />
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/workspace_line" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="80dp" android:padding="12dp" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Danh sách / bộ lọc" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/workspace_text" />
            <Button android:id="@+id/manageLists" style="@style/FlatButton" android:layout_width="132dp" android:layout_height="54dp" android:text="Tùy chỉnh   ›" />
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/workspace_line" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="80dp" android:padding="12dp" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Bộ hẹn giờ" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/workspace_text" />
            <Button android:id="@+id/settingsTimer" style="@style/FlatButton" android:layout_width="132dp" android:layout_height="54dp" android:text="Mở   ›" />
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/workspace_line" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="80dp" android:padding="12dp" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Báo cáo thói quen" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/workspace_text" />
            <Button android:id="@+id/settingsReport" style="@style/FlatButton" android:layout_width="132dp" android:layout_height="54dp" android:text="Xem   ›" />
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/workspace_line" />
        <TextView style="@style/PanelText" android:text="@string/local_account_detail" android:textSize="13sp" />
    </LinearLayout>
</ScrollView>