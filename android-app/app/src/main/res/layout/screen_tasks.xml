<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <FrameLayout android:layout_width="match_parent" android:layout_height="76dp">
        <TextView android:id="@+id/currentDate" style="@style/ScreenTitle" android:text="@string/today" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="48dp" android:layout_gravity="start|center_vertical" android:gravity="center_vertical" android:layout_marginStart="12dp">
            <ImageButton android:id="@+id/filterTasks" style="@style/IconButton" app:srcCompat="@drawable/ic_menu" android:contentDescription="@string/manage_lists" android:background="@drawable/control_gray" />
            <ImageButton android:id="@+id/openReport" style="@style/IconButton" app:srcCompat="@drawable/ic_chart" android:contentDescription="@string/habit_report" android:layout_marginStart="4dp" />
        </LinearLayout>
        <ImageButton android:id="@+id/openTimer" style="@style/IconButton" app:srcCompat="@drawable/ic_timer" android:contentDescription="@string/timer" android:layout_gravity="end|center_vertical" android:layout_marginEnd="10dp" />
        <Button android:id="@+id/showStats" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    </FrameLayout>
    <LinearLayout android:id="@+id/taskWeek" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="52dp" android:paddingLeft="8dp" android:paddingRight="8dp" android:layout_marginBottom="6dp" />
    <EditText android:id="@+id/searchTasks" android:layout_width="match_parent" android:layout_height="48dp" android:visibility="gone" android:inputType="text" android:singleLine="true" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@color/workspace_canvas">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="50dp" android:gravity="center_vertical" android:paddingLeft="12dp" android:paddingRight="8dp">
                <ImageView android:layout_width="22dp" android:layout_height="22dp" app:srcCompat="@drawable/ic_checklist" android:contentDescription="@null" />
                <TextView android:id="@+id/listHeading" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="Danh sách việc cần làm" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/workspace_text" />
                <TextView android:id="@+id/taskCount" android:layout_width="24dp" android:layout_height="wrap_content" android:gravity="center" android:textSize="16sp" android:textColor="@color/workspace_muted" />
                <ImageButton android:id="@+id/collapseTasks" style="@style/IconButton" app:srcCompat="@drawable/ic_chevron" android:contentDescription="Thu gọn / mở danh sách" android:layout_width="32dp" android:layout_height="32dp" android:padding="6dp" android:background="@drawable/collapse_circle" />
            </LinearLayout>
            <TextView android:id="@+id/taskSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" />
            <FrameLayout android:id="@+id/taskListContainer" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/taskList" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingLeft="6dp" android:paddingRight="6dp" android:paddingBottom="80dp" android:clipToPadding="false" />
                <TextView android:id="@+id/emptyMessage" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="@string/empty_message" android:textSize="16sp" android:textColor="@color/workspace_text" />
            </FrameLayout>
            <TextView android:id="@+id/habitHeading" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:text="Thói quen hằng ngày" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/workspace_text" android:visibility="gone" />
            <ScrollView android:id="@+id/habitScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:visibility="gone">
                <LinearLayout android:id="@+id/habitEntries" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="6dp" android:paddingBottom="80dp" />
            </ScrollView>
        </LinearLayout>
        <TextView android:id="@+id/addTask" style="@style/AddButton" />
    </FrameLayout>
</LinearLayout>
