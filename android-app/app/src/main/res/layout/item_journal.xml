<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/journal_card" android:padding="6dp" android:layout_marginBottom="8dp" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:id="@+id/noteMeta" android:layout_width="70dp" android:layout_height="48dp" android:gravity="center" android:background="@drawable/control_soft" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/workspace_text" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:layout_marginEnd="6dp" android:gravity="center_vertical" android:background="@drawable/control_soft">
            <TextView android:id="@+id/noteTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_weight="1" android:gravity="center_vertical" android:padding="8dp" android:textSize="14sp" android:textColor="@color/workspace_text" />
            <TextView android:id="@+id/noteProgress" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/workspace_text" />
        </LinearLayout>
        <ImageButton android:id="@+id/noteMore" style="@style/IconButton" android:background="@drawable/control_soft" app:srcCompat="@drawable/ic_more" android:contentDescription="Tùy chọn kết quả ngày" />
    </LinearLayout>
    <TextView android:id="@+id/notePreview" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="4dp" android:paddingTop="5dp" android:paddingBottom="3dp" android:textSize="12sp" android:textColor="@color/workspace_muted" />
</LinearLayout>
