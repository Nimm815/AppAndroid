<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/journal_card" android:foreground="?attr/selectableItemBackground" android:padding="16dp" android:layout_marginBottom="12dp" android:clickable="true" android:focusable="true">
    <TextView android:id="@+id/noteMeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/workspace_muted" />
    <TextView android:id="@+id/noteTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/workspace_text" android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/notePreview" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="14sp" android:textColor="@color/workspace_muted" android:lineSpacingExtra="2dp" android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/noteLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textSize="12sp" android:textColor="@color/workspace_muted" />
</LinearLayout>