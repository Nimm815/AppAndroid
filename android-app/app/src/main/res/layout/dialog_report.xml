<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/workspace_surface">

    <!-- Header -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:padding="12dp">

        <TextView
            style="@style/ScreenTitle"
            android:text="Báo cáo cá nhân" />

        <ImageButton
            android:id="@+id/closeReport"
            style="@style/IconButton"
            android:src="@drawable/ic_close"
            android:contentDescription="@string/close"
            android:layout_gravity="start|center_vertical" />
    </FrameLayout>

    <!-- Chọn khoảng thời gian: 7 ngày, 30 ngày, Tùy chọn -->
    <RadioGroup
        android:id="@+id/reportModes"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <RadioButton
            android:id="@+id/report7Days"
            style="@style/ReportTab"
            android:text="7 ngày"
            android:checked="true" />

        <RadioButton
            android:id="@+id/report30Days"
            style="@style/ReportTab"
            android:text="30 ngày" />

        <RadioButton
            android:id="@+id/reportCustom"
            style="@style/ReportTab"
            android:text="Tùy chọn" />
    </RadioGroup>

    <!-- Bộ lọc thói quen & nhãn thời gian -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp">

        <Spinner
            android:id="@+id/reportHabitFilter"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@drawable/control_gray"
            android:padding="6dp" />

        <Button
            android:id="@+id/reportPickCustomDate"
            style="@style/FlatButton"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:text="Chọn ngày"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/reportPeriodLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:text="16/10/2026 – 22/10/2026"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/workspace_accent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 3 Thẻ KPI chính -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <!-- Thẻ 1: Lượt ghi nhận -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/control_soft"
                    android:padding="10dp"
                    android:layout_marginEnd="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lượt ghi nhận"
                        android:textSize="11sp"
                        android:textColor="@color/workspace_muted" />

                    <TextView
                        android:id="@+id/reportTotalCheckIns"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/navigation_blue"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- Thẻ 2: Ngày có hoạt động -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/control_soft"
                    android:padding="10dp"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ngày hoạt động"
                        android:textSize="11sp"
                        android:textColor="@color/workspace_muted" />

                    <TextView
                        android:id="@+id/reportActiveDays"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/navigation_blue"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- Thẻ 3: Tỷ lệ hoàn thành -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/control_soft"
                    android:padding="10dp"
                    android:layout_marginStart="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tỷ lệ hoàn thành"
                        android:textSize="11sp"
                        android:textColor="@color/workspace_muted" />

                    <TextView
                        android:id="@+id/reportCompletionRate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/workspace_accent"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:id="@+id/reportCompletionDetail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Không gồm kỳ đang diễn ra"
                        android:textSize="9sp"
                        android:textColor="@color/workspace_muted"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Tiêu đề biểu đồ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Biểu đồ hoạt động theo ngày"
                android:textColor="@color/workspace_text"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginBottom="6dp" />

            <!-- Biểu đồ cột -->
            <vn.edu.taskmanager.view.DailyChartView
                android:id="@+id/reportChartView"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:background="@drawable/control_soft"
                android:layout_marginBottom="16dp" />

            <!-- Tiêu đề bảng thói quen -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chi tiết từng thói quen"
                android:textColor="@color/workspace_text"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/reportEntries"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>

    <!-- Nút hành động: Lưu PDF và Chia sẻ PDF -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:padding="8dp"
        android:background="@color/workspace_surface">

        <Button
            android:id="@+id/saveReportPdf"
            style="@style/FlatButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="Lưu PDF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/shareReportPdf"
            style="@style/BlackButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Chia sẻ PDF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
