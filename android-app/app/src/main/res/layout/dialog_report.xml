<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">
 <TextView style="@style/ScreenTitle" android:text="@string/habit_report" />
 <RadioGroup android:id="@+id/reportModes" android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal">
  <RadioButton android:id="@+id/reportWeek" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="@string/week" />
  <RadioButton android:id="@+id/reportMonth" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="@string/month" android:checked="true" />
  <RadioButton android:id="@+id/reportYear" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="@string/year" />
 </RadioGroup>
 <LinearLayout android:layout_width="match_parent" android:layout_height="56dp">
  <Button android:id="@+id/reportPrevious" android:layout_width="48dp" android:layout_height="match_parent" android:text="‹" android:textSize="26sp" android:padding="0dp" android:contentDescription="@string/previous_period" />
  <TextView android:id="@+id/reportPeriod" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textStyle="bold" />
  <Button android:id="@+id/reportToday" android:textSize="12sp" android:padding="0dp" android:maxLines="1" android:layout_width="80dp" android:layout_height="match_parent" android:text="@string/today" android:textAllCaps="false" />
  <Button android:id="@+id/reportNext" android:layout_width="48dp" android:layout_height="match_parent" android:text="›" android:textSize="26sp" android:padding="0dp" android:contentDescription="@string/next_period" />
 </LinearLayout>
 <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
  <LinearLayout android:id="@+id/reportEntries" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
 </ScrollView>
 <Button android:id="@+id/saveReportImage" style="@style/WideButton" android:text="@string/save_report_image" />
 <Button android:id="@+id/shareReport" android:backgroundTint="#7874B7" android:textColor="#FFFFFF" style="@style/WideButton" android:text="@string/share_report" />
 <Button android:id="@+id/closeReport" style="@style/WideButton" android:text="@string/close" />
</LinearLayout>
