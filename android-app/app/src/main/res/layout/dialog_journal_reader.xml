<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/workspace_surface">
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:paddingHorizontal="16dp" android:gravity="center_vertical">
        <ImageButton android:id="@+id/readerClose" style="@style/IconButton" app:srcCompat="@drawable/ic_close" android:contentDescription="Đóng trang nhật ký" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Trang nhật ký" android:gravity="center" android:textStyle="bold" android:textSize="17sp" android:textColor="@color/workspace_text" />
        <ImageButton android:id="@+id/readerBookmark" style="@style/IconButton" app:srcCompat="@drawable/ic_bookmark" android:contentDescription="Đánh dấu bài nhật ký" />
    </LinearLayout>
    <ScrollView android:id="@+id/readerScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:background="@color/workspace_page">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="28dp">
            <TextView android:id="@+id/readerDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/workspace_muted" />
            <TextView android:id="@+id/readerTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:fontFamily="serif" android:textSize="30sp" android:textStyle="bold" android:lineSpacingExtra="5dp" android:textColor="@color/workspace_text" />
            <View android:layout_width="48dp" android:layout_height="2dp" android:layout_marginTop="22dp" android:layout_marginBottom="22dp" android:background="@color/workspace_accent" />
            <TextView android:id="@+id/readerBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="serif" android:textSize="19sp" android:lineSpacingExtra="9dp" android:lineSpacingMultiplier="1.15" android:textColor="@color/workspace_text" android:textIsSelectable="true" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:gravity="center_vertical">
        <Button android:id="@+id/readerDelete" style="@style/FlatButton" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="Xóa bài" android:layout_marginEnd="12dp" />
        <Button android:id="@+id/readerEdit" style="@style/BlackButton" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="Sửa bài viết" />
    </LinearLayout>
</LinearLayout>
