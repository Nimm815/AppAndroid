<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
 <TextView style="@style/ScreenTitle" android:text="@string/journal" />
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingLeft="12dp" android:paddingRight="12dp">
  <EditText android:id="@+id/journalSearch" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:hint="@string/search_notes" android:inputType="text" android:singleLine="true" />
  <Button android:id="@+id/journalFilter" android:layout_width="wrap_content" android:layout_height="52dp" android:text="@string/all_notes" android:textAllCaps="false" />
 </LinearLayout>
 <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
  <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
   <LinearLayout android:id="@+id/journalEntries" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:paddingBottom="96dp" />
  </ScrollView>
  <TextView android:id="@+id/addNote" style="@style/AddButton" />
 </FrameLayout>
</LinearLayout>