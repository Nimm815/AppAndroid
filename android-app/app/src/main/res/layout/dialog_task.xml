<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="24dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:labelFor="@id/taskNameInput" android:text="@string/task_name" android:textSize="16sp" />
    <EditText android:id="@+id/taskNameInput" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:minHeight="48dp"
        android:hint="@string/name_hint" android:inputType="textCapSentences"
        android:maxLength="200" android:imeOptions="actionDone" />
</LinearLayout>
