<resources>
 <style name="FlatButton" parent="Widget.AppCompat.Button">
  <item name="android:background">@drawable/control_gray</item><item name="android:backgroundTint">@null</item><item name="backgroundTint">@null</item>
  <item name="android:textColor">@color/workspace_text</item><item name="android:textAllCaps">false</item><item name="android:textSize">16sp</item>
  <item name="android:minHeight">48dp</item><item name="android:minWidth">0dp</item><item name="android:padding">8dp</item><item name="android:gravity">center</item>
  <item name="android:stateListAnimator">@null</item><item name="android:elevation">0dp</item>
 </style>
 <style name="BlackButton" parent="FlatButton"><item name="android:background">@drawable/control_black</item><item name="android:textColor">#FFFFFF</item></style>
 <style name="IconButton"><item name="android:layout_width">44dp</item><item name="android:layout_height">44dp</item><item name="android:padding">9dp</item><item name="android:background">?attr/selectableItemBackgroundBorderless</item><item name="android:backgroundTint">@null</item><item name="android:scaleType">fitCenter</item><item name="android:tint">@color/workspace_text</item><item name="android:stateListAnimator">@null</item></style>
 <style name="TimerTab"><item name="android:layout_width">0dp</item><item name="android:layout_height">56dp</item><item name="android:layout_weight">1</item><item name="android:button">@null</item><item name="android:background">@drawable/timer_tab</item><item name="android:gravity">center</item><item name="android:padding">0dp</item><item name="android:textSize">16sp</item><item name="android:textColor">@color/workspace_text</item></style>
 <style name="ReportTab" parent="TimerTab"><item name="android:background">@drawable/report_tab</item><item name="android:textColor">@color/report_tab_text</item><item name="android:layout_height">48dp</item><item name="android:layout_marginStart">3dp</item><item name="android:layout_marginEnd">3dp</item></style>
 <style name="DrawerRow" parent="FlatButton"><item name="android:layout_width">match_parent</item><item name="android:layout_height">56dp</item><item name="android:background">?attr/selectableItemBackground</item><item name="android:gravity">start|center_vertical</item><item name="android:padding">10dp</item><item name="android:textStyle">bold</item><item name="android:drawablePadding">12dp</item></style>
 <style name="DrawerHeading"><item name="android:layout_width">match_parent</item><item name="android:layout_height">60dp</item><item name="android:gravity">center</item><item name="android:textSize">15sp</item><item name="android:textStyle">bold</item><item name="android:textColor">@color/workspace_text</item></style>
</resources>